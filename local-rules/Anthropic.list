# Local additions - Anthropic
# Claude CLI, Web, Desktop, Cowork, Chrome bridge, Console, MCP and file/CDN hosts
# https://code.claude.com/docs/en/network-config#network-access-requirements
# https://code.claude.com/docs/en/desktop#network-access-requirements
# https://support.claude.com/en/articles/13065128-claude-in-chrome-admin-controls
DOMAIN-SUFFIX,anthropic.com
DOMAIN-SUFFIX,claude.ai
DOMAIN-SUFFIX,claude.app
DOMAIN-SUFFIX,claude.com
DOMAIN-SUFFIX,claudemcpcontent.com
DOMAIN-SUFFIX,claudeusercontent.com
DOMAIN,storage.googleapis.com

# Enterprise sign-in CAPTCHA, including dynamic hCaptcha hostnames
# https://claude.com/docs/third-party/claude-desktop/admin-console-claude-code
DOMAIN-SUFFIX,hcaptcha.com

# Claude Code package registry, plugin marketplaces and release notes
# https://code.claude.com/docs/en/network-config#network-access-requirements
DOMAIN,registry.npmjs.org
DOMAIN,github.com
DOMAIN,raw.githubusercontent.com

# Desktop Code tab Gerrit lookups for trusted googlesource.com repositories
# https://code.claude.com/docs/en/network-config#network-access-requirements
DOMAIN-WILDCARD,*-review.googlesource.com

# Node.js and optional local MCP tooling: registry, uv, PyPI and GitHub packages/releases
# https://code.claude.com/docs/en/mcp
# https://github.com/modelcontextprotocol/registry
# https://nodejs.org/en/download
# https://docs.astral.sh/uv/getting-started/installation/
# https://docs.github.com/en/actions/reference/runners/github-hosted-runners#communication-requirements-for-github-hosted-runners
DOMAIN-SUFFIX,modelcontextprotocol.io
DOMAIN,nodejs.org
DOMAIN,astral.sh
DOMAIN,pypi.org
DOMAIN,files.pythonhosted.org
DOMAIN,api.github.com
DOMAIN,codeload.github.com
DOMAIN,release-assets.githubusercontent.com

# Homebrew metadata, updates and optional dependency bottles
# https://code.claude.com/docs/en/network-config#network-access-requirements
# https://docs.brew.sh/Manpage
# https://formulae.brew.sh/cask/claude-code
DOMAIN,formulae.brew.sh
DOMAIN,ghcr.io
DOMAIN,pkg-containers.githubusercontent.com

# Claude in Chrome extension download and updates
# https://support.claude.com/en/articles/13065128-claude-in-chrome-admin-controls
# https://support.google.com/chrome/a/answer/6334001#chrome_web_store
DOMAIN,chromewebstore.google.com
DOMAIN,clients2.googleusercontent.com
DOMAIN,update.googleapis.com

# Optional Artifact fonts and JavaScript libraries
# https://code.claude.com/docs/en/network-config#third-party-hosts-for-artifact-fonts-and-libraries
DOMAIN,fonts.googleapis.com
DOMAIN,fonts.gstatic.com
DOMAIN,cdnjs.cloudflare.com
DOMAIN,cdn.jsdelivr.net
DOMAIN,cdn.tailwindcss.com
DOMAIN,code.jquery.com
DOMAIN,unpkg.com

# Claude Code operational telemetry and errors. The old keyword also matched other Datadog customers.
# https://code.claude.com/docs/en/network-config#network-access-requirements
# Exclude upstream: DOMAIN-KEYWORD,datadog
# Exclude upstream: DOMAIN-SUFFIX,datadoghq.com
DOMAIN,http-intake.logs.us5.datadoghq.com
DOMAIN,browser-intake-us5-datadoghq.com

# Network - official inbound Claude API and Console destinations
